# Default is offline demo. Node 24+ loads .env when you run npm start.
PORT=3000
AI_MODE=demo
# Live mode sends questions, recent messages and farm records to this provider.
# Enable the profile's AI consent checkbox as well.
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=your_private_api_key
# Set an available chat-completions-compatible model from your provider.
LLM_MODEL=
